@model List<Entry>
@{
    ViewData["Title"] = "My enrolments";
    var today = Display.Today;
    var upcoming = Model.Where(e => e.EventDate >= today).OrderBy(e => e.EventDate).ToList();
    var past = Model.Where(e => e.EventDate < today).ToList();
}
<div class="rd-page-header">
    <div>
        <p class="rd-eyebrow">My race diary</p>
        <h1 class="rd-display">My enrolments</h1>
        <p class="text-secondary">Every event you've entered.</p>
    </div>
    <div class="rd-actions">
        <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Find a race</a>
    </div>
</div>

<partial name="_StatusMessages" />

@if (Model.Count == 0)
{
    <div class="rd-empty-inline">
        You haven't entered any events yet.
        <div class="mt-3"><a class="btn btn-rd" asp-controller="Home" asp-action="Index">Browse upcoming races</a></div>
    </div>
}
else
{
    @foreach (var (title, rows, isUpcoming) in new[] { ("Upcoming", upcoming, true), ("Past", past, false) })
    {
        if (rows.Count == 0)
        {
            continue;
        }

        <section class="mb-5" aria-label="@title enrolments">
            <div class="rd-section-title"><h2>@title</h2></div>
            <div class="rd-table-wrap">
                <table class="table rd-table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Event</th>
                            <th scope="col">Date</th>
                            <th scope="col">Category</th>
                            <th scope="col">Bib</th>
                            <th scope="col">Status</th>
                            <th scope="col">Payment</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in rows)
                        {
                            var active = e.Status is "Pending" or "Confirmed";
                            <tr>
                                <td><a class="fw-semibold" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                                <td class="text-nowrap">@Display.ShortDate(e.EventDate)</td>
                                <td>@e.CategoryName <span class="text-secondary small">· @Display.Distance(e.DistanceKm)</span></td>
                                <td>@(e.BibNumber ?? "—")</td>
                                <td><partial name="_StatusBadge" model="e.Status" /></td>
                                <td><partial name="_StatusBadge" model="e.PaymentStatus" /></td>
                                <td class="text-end text-nowrap">
                                    @if (isUpcoming && active)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@e.EntryId" method="post" class="d-inline"
                                              data-confirm="Withdraw from @e.EventName? Your place will be released.">
                                            <button type="submit" class="btn btn-sm btn-rd-danger">Withdraw</button>
                                        </form>
                                    }
                                    else if (e.ResultId is not null)
                                    {
                                        <a class="btn btn-sm btn-rd-ghost" asp-controller="Results" asp-action="Index">View result</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}
