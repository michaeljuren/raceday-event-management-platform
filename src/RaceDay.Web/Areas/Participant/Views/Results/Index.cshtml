@model List<PerformanceHistoryItem>
@{
    ViewData["Title"] = "My results";
    var finished = Model.Where(r => r.FinishStatus == "Finished").ToList();
    var bestPlace = finished.Where(r => r.OverallPosition is not null).Select(r => r.OverallPosition!.Value).DefaultIfEmpty().Min();
    var totalKm = finished.Sum(r => r.DistanceKm);
}
<div class="rd-page-header">
    <div>
        <p class="rd-eyebrow">Performance history</p>
        <h1 class="rd-display">My results</h1>
        <p class="text-secondary">Finish times and positions from every race you've completed.</p>
    </div>
</div>

<partial name="_StatusMessages" />

@if (Model.Count == 0)
{
    <div class="rd-empty-inline">
        No results yet. Results appear here once an organiser has captured them after race day.
        <div class="mt-3"><a class="btn btn-rd" asp-controller="Home" asp-action="Index">Find your next race</a></div>
    </div>
}
else
{
    <div class="rd-stats">
        <div class="rd-stat">
            <div class="rd-stat-label">Races finished</div>
            <div class="rd-stat-value">@finished.Count</div>
            <div class="rd-stat-hint">of @Model.Count recorded</div>
        </div>
        <div class="rd-stat is-blue">
            <div class="rd-stat-label">Distance raced</div>
            <div class="rd-stat-value">@totalKm.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</div>
            <div class="rd-stat-hint">kilometres</div>
        </div>
        <div class="rd-stat is-green">
            <div class="rd-stat-label">Best overall place</div>
            <div class="rd-stat-value">@(bestPlace == 0 ? "—" : $"#{bestPlace}")</div>
        </div>
    </div>

    <div class="rd-table-wrap">
        <table class="table rd-table table-hover">
            <thead>
                <tr>
                    <th scope="col">Event</th>
                    <th scope="col">Date</th>
                    <th scope="col">Category</th>
                    <th scope="col">Result</th>
                    <th scope="col" class="rd-num">Time</th>
                    <th scope="col" class="rd-num">Overall</th>
                    <th scope="col" class="rd-num">Category</th>
                    <th scope="col" class="rd-num">Gender</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold" asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId">@r.EventName</a>
                            <div class="small text-secondary">@r.Discipline</div>
                        </td>
                        <td class="text-nowrap">@Display.ShortDate(r.EventDate)</td>
                        <td>@r.CategoryName <span class="text-secondary small">· @Display.Distance(r.DistanceKm)</span></td>
                        <td><partial name="_StatusBadge" model="r.FinishStatus" /></td>
                        <td class="rd-num fw-semibold">@Display.FinishTime(r.FinishTime)</td>
                        <td class="rd-num">@Display.Position(r.OverallPosition)</td>
                        <td class="rd-num">@Display.Position(r.CategoryPosition)</td>
                        <td class="rd-num">@Display.Position(r.GenderPosition)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
