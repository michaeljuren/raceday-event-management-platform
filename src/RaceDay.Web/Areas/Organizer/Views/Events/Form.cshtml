@model RaceDay.Web.Areas.Organizer.Models.EventFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "New event" : $"Edit {Model.EventName}";
}
<nav class="rd-breadcrumb" aria-label="Breadcrumb">
    @if (Model.IsNew)
    {
        <a asp-action="Index">&larr; Events</a>
    }
    else
    {
        <a asp-action="Details" asp-route-id="@Model.EventId">&larr; Back to event</a>
    }
</nav>

<div class="rd-page-header">
    <div>
        <p class="rd-eyebrow">@(Model.IsNew ? "Create" : "Edit") event</p>
        <h1 class="rd-display">@(Model.IsNew ? "New race day" : Model.EventName)</h1>
        @if (Model.IsNew)
        {
            <p class="text-secondary">New events start as drafts. Only you can see them until you publish.</p>
        }
    </div>
</div>

<partial name="_StatusMessages" />

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" class="rd-card" novalidate>
    <input type="hidden" asp-for="BannerImageUrl" />

    <div class="rd-form-section">
        <h2>The basics</h2>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" placeholder="e.g. Cape Town Peninsula Marathon" />
                <span asp-validation-for="EventName" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Discipline" class="form-label"></label>
                <select asp-for="Discipline" class="form-select" asp-items="@(new SelectList(EventFilterViewModel.Disciplines))"></select>
                <span asp-validation-for="Discipline" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Route highlights, parking, race-pack collection…"></textarea>
                <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
            </div>
        </div>
    </div>

    <div class="rd-form-section">
        <h2>When and where</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="VenueId" class="form-label"></label>
                <select asp-for="VenueId" class="form-select" asp-items="Model.Venues">
                    <option value="">Choose a venue…</option>
                </select>
                <span asp-validation-for="VenueId" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" value="@Model.EventDate?.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="EventDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="time" class="form-control" value="@Model.StartTime?.ToString("HH:mm")" />
                <span asp-validation-for="StartTime" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="RegistrationOpenDate" class="form-label"></label>
                <input asp-for="RegistrationOpenDate" type="datetime-local" class="form-control" value="@Model.RegistrationOpenDate?.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="RegistrationOpenDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="RegistrationCloseDate" class="form-label"></label>
                <input asp-for="RegistrationCloseDate" type="datetime-local" class="form-control" value="@Model.RegistrationCloseDate?.ToString("yyyy-MM-ddTHH:mm")" />
                <div class="form-text">South African time. Entries must close on or before race day.</div>
                <span asp-validation-for="RegistrationCloseDate" class="invalid-feedback d-block"></span>
            </div>
        </div>
    </div>

    <div class="rd-form-section">
        <h2>Distance</h2>
        @if (Model.IsNew)
        {
            <p class="text-secondary">Add the main distance now. You can add more distances and age groups as categories afterwards.</p>
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <label asp-for="InitialDistanceKm" class="form-label"></label>
                    <input asp-for="InitialDistanceKm" type="number" step="0.01" min="0.01" class="form-control" placeholder="21.1" />
                    <span asp-validation-for="InitialDistanceKm" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="InitialEntryFee" class="form-label"></label>
                    <input asp-for="InitialEntryFee" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="InitialEntryFee" class="invalid-feedback d-block"></span>
                </div>
            </div>
        }
        else
        {
            <p class="mb-2">
                @if (Model.DistancesKm.Count == 0)
                {
                    <span class="text-secondary">No distances yet.</span>
                }
                @foreach (var km in Model.DistancesKm)
                {
                    <span class="rd-chip me-1">@Display.Distance(km)</span>
                }
            </p>
            <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@Model.EventId">Manage distances and categories &rarr;</a>
        }
    </div>

    <div class="rd-form-section">
        <h2>Banner</h2>
        <img id="banner-preview" class="rd-banner-preview" src="@Model.BannerImageUrl" alt="Banner preview" hidden="@string.IsNullOrEmpty(Model.BannerImageUrl)" />
        <label asp-for="Banner" class="form-label"></label>
        <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" data-preview="#banner-preview" />
        <div class="form-text">JPEG, PNG or WebP, up to 5 MB. A wide image (about 1600 × 600) looks best.</div>
        <span asp-validation-for="Banner" class="invalid-feedback d-block"></span>
    </div>

    <div class="rd-form-actions">
        <button type="submit" class="btn btn-rd">@(Model.IsNew ? "Create draft event" : "Save changes")</button>
        <a class="btn btn-rd-ghost" href="@(Model.IsNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.EventId }))">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
