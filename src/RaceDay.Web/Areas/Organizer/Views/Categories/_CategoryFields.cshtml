@model RaceDay.Web.Areas.Organizer.Models.CategoryFormViewModel
@using RaceDay.Web.Areas.Organizer.Models
<div class="row g-3">
    <div class="col-12">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" placeholder="e.g. 10km, Half Marathon, Under 20" />
        <span asp-validation-for="CategoryName" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="DistanceKm" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" placeholder="Any" />
        <span asp-validation-for="MinAge" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="EntryFee" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-6">
        <label asp-for="MaxParticipants" class="form-label"></label>
        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" placeholder="Unlimited" />
        <span asp-validation-for="MaxParticipants" class="invalid-feedback d-block"></span>
    </div>
    <div class="col-12">
        <label asp-for="GenderRestriction" class="form-label"></label>
        <select asp-for="GenderRestriction" class="form-select" asp-items="@(new SelectList(CategoryFormViewModel.GenderOptions))"></select>
        <span asp-validation-for="GenderRestriction" class="invalid-feedback d-block"></span>
    </div>
</div>
