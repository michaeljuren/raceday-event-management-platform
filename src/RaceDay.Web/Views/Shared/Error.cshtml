@model ErrorViewModel
@{
    ViewData["Title"] = Model?.Title ?? "Error";
}
<section class="rd-empty rd-card">
    <div class="rd-error-code" aria-hidden="true">@(Model?.StatusCode ?? 500)</div>
    <h1 class="rd-display mt-3">@(Model?.Title ?? "Something went wrong")</h1>
    <p class="text-secondary">@(Model?.Message ?? "An unexpected error occurred while processing your request.")</p>
    <div class="rd-actions justify-content-center mt-4">
        <a class="btn btn-rd" href="/">Back to the start line</a>
        <a class="btn btn-rd-ghost" asp-area="" asp-controller="Events" asp-action="Index">Browse events</a>
    </div>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-secondary mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
    }
</section>
