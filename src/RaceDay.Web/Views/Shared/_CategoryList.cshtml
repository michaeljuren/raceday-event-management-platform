@model IReadOnlyList<Category>
@if (Model.Count == 0)
{
    <div class="rd-empty-inline">No categories have been added yet.</div>
}
else
{
    <ul class="rd-category-list">
        @foreach (var c in Model)
        {
            <li class="rd-category">
                <div class="d-flex align-items-center gap-3">
                    <span class="rd-category-distance">@Display.Distance(c.DistanceKm)</span>
                    <div>
                        <strong>@c.CategoryName</strong>
                        <div class="text-secondary small">
                            @(c.MinAge is { } age ? $"Age {age}+" : "All ages")
                            · @(c.GenderRestriction == "Open" ? "Open to all" : $"{c.GenderRestriction} only")
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <strong>@Display.Money(c.EntryFee)</strong>
                    <div class="small @(c.SpotsRemaining == 0 ? "text-danger" : "text-secondary")">
                        @(c.SpotsRemaining switch { null => "Unlimited spots", 0 => "Full", var n => $"{n} spot{(n == 1 ? "" : "s")} left" })
                    </div>
                </div>
            </li>
        }
    </ul>
}
